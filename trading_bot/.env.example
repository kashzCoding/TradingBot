# Alpaca API credentials — get these from https://app.alpaca.markets
# Paper trading keys and live trading keys are different, generate them separately.
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# true = paper trading endpoint (https://paper-api.alpaca.markets)
# false = live trading endpoint (https://api.alpaca.markets) — real money, use with caution
ALPACA_PAPER=true

# Market-data feed for historical bars: "iex" or "sip" (also "delayed_sip",
# "otc"). Free/paper accounts only have access to "iex" — a request without
# an explicit feed silently defaults to "sip" and returns EMPTY data (no
# error!) if your account isn't entitled to it. Only change this to "sip"
# if you have a paid market-data subscription with SIP access.
ALPACA_DATA_FEED=iex

# Comma-separated list of symbols to watch (used unless USE_NASDAQ100=true)
WATCHLIST=AAPL,MSFT,GOOGL,AMZN,NVDA

# true = ignore WATCHLIST and scan the full Nasdaq-100 instead (see nasdaq100.py)
USE_NASDAQ100=false

# --- Trading mode ---
# standard = longer-term swing trading (SMA 50/200, 15Min bars, wider stops)
# fast     = shorter-term trading (SMA 9/21, 5Min bars, tighter stops, smaller
#            position size) -- see README.md for the tradeoffs before using it
# Sets sensible defaults for TIMEFRAME, CHECK_INTERVAL_MINUTES, SMA_FAST,
# SMA_SLOW, POSITION_SIZE_PCT, STOP_LOSS_PCT and TAKE_PROFIT_PCT below.
# Leave those commented out to use the mode's defaults, or uncomment any one
# of them to override it regardless of TRADING_MODE.
TRADING_MODE=standard

# Bar timeframe used for indicator calculation: 1Min,5Min,15Min,1Hour,1Day
# Default: 15Min (standard) / 5Min (fast)
# TIMEFRAME=15Min

# How often (in minutes) the bot scans the watchlist
# Default: 15 (standard) / 5 (fast)
# CHECK_INTERVAL_MINUTES=15

# How often (in seconds) the independent safety check runs, which verifies
# open positions still have an active stop-loss order (see bot.py's
# run_safety_check_once / _run_safety_check_loop). Runs on its own
# background thread, separate from CHECK_INTERVAL_MINUTES above, so a
# fast-falling price doesn't sit unprotected for up to a full scan interval.
# Default: 300 (5 minutes). Not mode-aware.
# SAFETY_CHECK_INTERVAL_SECONDS=300

# How many seconds AFTER a bar closes the strategy scan starts. The scan is
# aligned to the clock boundaries of CHECK_INTERVAL_MINUTES (:00/:15/:30/:45
# for 15 minutes) so it always sees the bar that just finished; the short
# delay gives Alpaca time to publish that bar. Only completed bars are
# evaluated -- a still-running bar is dropped.
# SCAN_DELAY_AFTER_BAR_CLOSE_SECONDS=30

# --- Batching (only matters for large watchlists like Nasdaq-100) ---
# Symbols per market-data request; keeps requests/minute well under Alpaca's
# rate limits instead of firing one HTTP call per symbol.
DATA_BATCH_SIZE=30
# Pause between batches, in seconds.
DATA_BATCH_PAUSE_SECONDS=1.0

# --- Strategy parameters ---
# SMA periods are mode-aware, default: 50/200 (standard) / 9/21 (fast)
# SMA_FAST=50
# SMA_SLOW=200
# RSI and MACD periods are identical in both modes
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
# How many bars back a MACD bullish crossover still counts as a valid entry
# trigger (not just the current bar) -- the crossover usually happens before
# the SMA trend filter confirms an uptrend, so a window of 1 lets most valid
# entries slip by. Not mode-aware.
MACD_CROSS_LOOKBACK_BARS=5

# How many of the three exit conditions (death cross, MACD bearish
# crossover, RSI overbought) must be true AT THE SAME TIME before an open
# position is sold. Default 2 instead of 1: any single condition alone can
# cut a running uptrend short too early (trend capture), while requiring 2
# still reliably protects against real downtrends (downside protection).
# 1 = old behavior (any single condition sells immediately). Must be 1-3,
# not mode-aware.
EXIT_CONFIRMATIONS_REQUIRED=2

# --- Risk management ---
# Max % of account equity risked per single trade (position sizing)
# Mode-aware, default: 2.0 (standard) / 1.0 (fast)
# POSITION_SIZE_PCT=2.0
# Stop-loss and take-profit distance from entry, in percent
# Mode-aware, default: 2.0/4.0 (standard) / 1.0/2.0 (fast)
# STOP_LOSS_PCT=2.0
# TAKE_PROFIT_PCT=4.0
# No new positions for the rest of the day once account equity is down this
# % versus the previous trading day's close (Alpaca's last_equity). Counts
# everything: stop-loss fills, signal exits and open paper losses. Exit
# signals for open positions stay active. Hard limit, identical in both modes -- TRADING_MODE=fast
# does NOT loosen this.
MAX_DAILY_LOSS_PCT=3.0
# Maximum number of simultaneously open positions (0 = no limit). Together
# with POSITION_SIZE_PCT this caps how much of the account is invested:
# 25 positions x 2% = at most ~50%. Existing positions above the limit are
# NOT closed -- the bot just opens no new ones until it is below the limit.
MAX_OPEN_POSITIONS=25

# --- Pattern-Modul (Trendlinien-/Chartmuster-Erkennung, siehe patterns.py) ---
# Komplett optional, per Default aus. true = zusaetzliches Signal aus
# automatisch erkannten Trendlinien/Mustern fliesst in die Entscheidung ein
# (bestaetigt/verwirft ein bestehendes BUY/SELL-Signal, loest aber nie
# selbst einen Trade aus). Siehe README.md fuer Details.
PATTERN_ENABLED=false

# Anzahl Kerzen links/rechts fuer die Swing-High/Low-Erkennung
PATTERN_PIVOT_WINDOW=4
# Mindest-/Maximalanzahl Pivots, durch die eine Trendlinie gefittet wird
PATTERN_MIN_TRENDLINE_PIVOTS=3
PATTERN_MAX_TRENDLINE_PIVOTS=5
# Wie weit der Kurs ueber/unter die Trendlinie schliessen muss, um als
# "signifikanter" Ausbruch zu zaehlen (in Prozent des Linienwerts)
PATTERN_BREAKOUT_THRESHOLD_PCT=0.3
# Mindest-Konfidenz (0-1), damit das Pattern-Signal im "confirm"-Modus ein
# bestehendes Signal bestaetigen darf
PATTERN_MIN_CONFIDENCE=0.5
# "confirm"  = Pattern-Signal muss dem Indikator-Signal zustimmen, sonst HOLD
# "weighted" = gewichtete Kombination aus Indikator- und Pattern-Score
PATTERN_COMBINE_MODE=confirm
# Gewicht des Pattern-Anteils bei PATTERN_COMBINE_MODE=weighted (0-1)
PATTERN_WEIGHT=0.4
# Toleranz (in Prozent) fuer das Clustern von Pivots zu Support/Resistance-
# Zonen bzw. fuer die Double-Top/Bottom-Erkennung
PATTERN_SR_ZONE_TOLERANCE_PCT=0.5

# Path to the CSV trade log
TRADE_LOG_PATH=trades.csv

# --- Telegram-Benachrichtigung bei fehlgeschlagenen Trades (siehe notifier.py) ---
# Komplett optional -- leer lassen, um diese Sofort-Benachrichtigungen
# auszuschalten (Fehlschlaege werden dann weiterhin normal geloggt, nur
# ohne Telegram-Nachricht). Kann denselben Bot/Chat wie deploy/notify.conf
# verwenden oder einen eigenen -- beides ist unabhaengig voneinander.
# Bot-Token vom @BotFather, Chat-ID z.B. ueber @userinfobot herausfinden.
# TELEGRAM_BOT_TOKEN=
#
# Zwei getrennte Chats (gleicher Bot), damit seltene wichtige Meldungen
# nicht zwischen haeufigen Routine-Meldungen im selben Chat untergehen:
#
# TELEGRAM_CHAT_ID_ALERTS: haeufige Routine-Meldungen -- Order-Fehlschlaege
# und automatisch nachgelegte Stop-Loss-Orders (z.B. "UNGESCHUETZTE
# POSITION ... Stop-Loss nachgelegt"). Kann so bleiben wie bisher: der alte
# Name TELEGRAM_CHAT_ID funktioniert weiterhin als Fallback, falls
# TELEGRAM_CHAT_ID_ALERTS nicht gesetzt ist.
# TELEGRAM_CHAT_ID_ALERTS=
#
# TELEGRAM_CHAT_ID_STATUS: seltene, wichtige Meldungen -- jeder
# KRITISCH-Alarm (Position konnte weder per Stop-Loss noch per Market-Sell
# geschuetzt werden, der unabhaengige Sicherheits-Check-Thread ist
# gestorben, etc.). Leer lassen -> diese Meldungen werden nur geloggt
# (mit WARNING, "Status-Kanal nicht konfiguriert"), nicht per Telegram
# verschickt.
# TELEGRAM_CHAT_ID_STATUS=

